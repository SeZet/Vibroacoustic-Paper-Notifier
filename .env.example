# Copy this file to .env.local for local development.
# On Vercel, set these under Project -> Settings -> Environment Variables.

# Postgres connection string. Added automatically when you connect a Neon
# database to the project in Vercel (Storage tab).
DATABASE_URL=

# Your Anthropic API key from https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Any long random string. Vercel sends it with each scheduled run so that
# strangers cannot trigger scans (which cost API credit).
CRON_SECRET=

# --- Optional ---
# Claude model used to judge relevance (default: claude-opus-5-5).
# claude-sonnet-5-5 is cheaper, claude-haiku-5-5 is much cheaper.
# CLAUDE_MODEL=claude-opus-5-5

# Minimum relevance score (1-10) for a paper to be recommended (default: 6).
# MIN_SCORE=6

# Contact email sent to Crossref/OpenAlex so they route you to their faster
# "polite" pool. Recommended but optional.
# CONTACT_EMAIL=

# Free API keys raise rate limits; not required.
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
